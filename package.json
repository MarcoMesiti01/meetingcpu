{
  "name": "meetingcpu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "postinstall": "node scripts/setup-python.mjs",
    "dev": "node scripts/dev.mjs",
    "download:model": "node scripts/setup-python.mjs --download-model",
    "download:diarization": "node scripts/setup-python.mjs --download-diarization",
    "test": "npm run test --workspaces --if-present && npm run test:scripts && npm run test:python",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:python": "node scripts/setup-python.mjs --test-python",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
